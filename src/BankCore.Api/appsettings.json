{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "BankCore": ""
  },
  "Database": {
    "Provider": "SqlServer",
    "InitializeOnStartup": true
  },
  "Jwt": {
    "Issuer": "BankCore.Api",
    "Audience": "BankCore.Clients",
    "SigningKey": "",
    "ExpiryMinutes": 30
  },
  "TransferLimits": {
    "SingleTransferLimit": 500000,
    "DailyTransferLimit": 1000000
  },
  "Security": {
    "MaxFailedLoginAttempts": 5,
    "LockoutMinutes": 15
  },
  "RateLimiting": {
    "LoginPermitLimitPerMinute": 5
  },
  "Seed": {
    "Enabled": false
  }
}
